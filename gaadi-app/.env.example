# Supabase project that holds the data (server-side only; never exposed to browsers)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_KEY=sb_publishable_xxx
# Same project URL, used by browsers to load report photos (public bucket)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Contact shown to OpenStreetMap services in the User-Agent (their usage policy asks for one)
OSM_CONTACT=you@example.com

# Your deployed URL, e.g. https://gaadibantha.vercel.app (used for share links and link previews)
NEXT_PUBLIC_SITE_URL=

# Key only this server knows. The database stores its SHA-256 and rejects writes without it,
# because the Supabase publishable key above is public. Generate with: openssl rand -hex 32
GAADI_SERVER_KEY=
# Signs the login cookie. Any long random string: openssl rand -hex 32
SESSION_SECRET=
# Google sign-in: OAuth "Web application" client ID from Google Cloud Console
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
