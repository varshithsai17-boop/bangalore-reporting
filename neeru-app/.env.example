# ---- Required ----
# Supabase project that holds the flood reports (server-side only; never exposed to browsers)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_KEY=sb_publishable_xxx

# ---- Optional: Google Maps (recommended for production) ----
# Leave both empty to run on free OpenStreetMap data (MapLibre map + OSRM routes + Photon search).
# Google is used only when BOTH are set.
# Server key: enable "Routes API", "Places API (New)" and "Geocoding API". Restrict it to those APIs.
GOOGLE_MAPS_API_KEY=
# Browser key: enable "Maps JavaScript API". Restrict it to your domain (HTTP referrers).
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Contact shown to OpenStreetMap services in the User-Agent (their usage policy asks for one)
OSM_CONTACT=you@example.com

# Your deployed URL (used for link previews), e.g. https://neeru.vercel.app
NEXT_PUBLIC_SITE_URL=

# Optional: your own OSRM server for free-mode routing (defaults to the public demo server)
OSRM_URL=
